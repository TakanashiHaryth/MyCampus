rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPrivateProfile(uid) {
      return request.resource.data.keys().hasAll([
          'uid', 'name', 'username', 'usernameNormalized', 'studentId',
          'studentIdNormalized', 'studentEmail', 'className', 'course',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'username', 'usernameNormalized', 'studentId',
          'studentIdNormalized', 'studentEmail', 'className', 'course',
          'avatarUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.username is string
        && request.resource.data.usernameNormalized is string
        && request.resource.data.usernameNormalized.matches('^[a-z0-9._-]{3,30}$')
        && request.resource.data.studentId is string
        && request.resource.data.studentIdNormalized is string
        && request.resource.data.studentIdNormalized.matches('^[A-Z0-9-]{3,30}$')
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.className is string
        && request.resource.data.course is string;
    }

    function publicMatchesPrivate(uid) {
      let privateProfile = getAfter(
        /databases/$(database)/documents/users/$(uid)
      ).data;
      return request.resource.data.uid == uid
        && request.resource.data.name == privateProfile.name
        && request.resource.data.username == privateProfile.username
        && request.resource.data.usernameNormalized == privateProfile.usernameNormalized
        && request.resource.data.studentId == privateProfile.studentId
        && request.resource.data.studentIdNormalized == privateProfile.studentIdNormalized
        && request.resource.data.className == privateProfile.className
        && request.resource.data.course == privateProfile.course
        && request.resource.data.avatarUrl == privateProfile.avatarUrl;
    }

    function privateMatchesPublicAndLookups(uid) {
      let publicProfile = getAfter(
        /databases/$(database)/documents/publicProfiles/$(uid)
      ).data;
      let usernameLookup = getAfter(
        /databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized)
      ).data;
      let studentIdLookup = getAfter(
        /databases/$(database)/documents/studentIds/$(request.resource.data.studentIdNormalized)
      ).data;
      return publicProfile.uid == uid
        && publicProfile.name == request.resource.data.name
        && publicProfile.username == request.resource.data.username
        && publicProfile.usernameNormalized == request.resource.data.usernameNormalized
        && publicProfile.studentId == request.resource.data.studentId
        && publicProfile.studentIdNormalized == request.resource.data.studentIdNormalized
        && publicProfile.className == request.resource.data.className
        && publicProfile.course == request.resource.data.course
        && publicProfile.avatarUrl == request.resource.data.avatarUrl
        && usernameLookup.uid == uid
        && usernameLookup.value == request.resource.data.usernameNormalized
        && studentIdLookup.uid == uid
        && studentIdLookup.value == request.resource.data.studentIdNormalized;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && validPrivateProfile(uid)
        && privateMatchesPublicAndLookups(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && validPrivateProfile(uid)
        && privateMatchesPublicAndLookups(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'username', 'usernameNormalized', 'studentId',
          'studentIdNormalized', 'className', 'course', 'avatarUrl', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /devices/{deviceId} {
        allow get, list, create, update, delete: if isOwner(uid);
      }
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'username', 'usernameNormalized', 'studentId',
          'studentIdNormalized', 'className', 'course', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'username', 'usernameNormalized', 'studentId',
          'studentIdNormalized', 'className', 'course', 'avatarUrl', 'updatedAt'
        ])
        && publicMatchesPrivate(uid)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'value', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value == username
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        ).data.usernameNormalized == username;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        ).data.usernameNormalized != username;
    }

    match /studentIds/{studentId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'value', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value == studentId
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        ).data.studentIdNormalized == studentId;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        ).data.studentIdNormalized != studentId;
    }

    match /friendships/{friendshipId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'users', 'status', 'requestedBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && friendshipId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'requestedBy', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == 'pending'
            && request.auth.uid != resource.data.requestedBy
            && request.resource.data.requestedBy == resource.data.requestedBy
            && request.resource.data.status in ['accepted', 'rejected']
          )
          ||
          (
            resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid
          )
        );
      allow delete: if signedIn()
        && request.auth.uid in resource.data.users
        && resource.data.status == 'accepted';
    }

    match /schedules/{scheduleId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.sharedWith;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.sharedWith
        && request.resource.data.status in [
          'scheduled', 'cancelled', 'rescheduled', 'completed'
        ];
      allow update: if signedIn()
        && request.auth.uid in resource.data.sharedWith
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdBy in request.resource.data.sharedWith
        && request.resource.data.status in [
          'scheduled', 'cancelled', 'rescheduled', 'completed'
        ]
        && (
          request.auth.uid == resource.data.createdBy
          || (
            request.resource.data.sharedWith == resource.data.sharedWith
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'subject', 'status', 'startAt', 'endAt', 'room', 'updatedAt'
            ])
          )
        );
      allow delete: if signedIn()
        && request.auth.uid == resource.data.createdBy;
    }

    match /notices/{noticeId} {
      allow get, list: if signedIn()
        && (
          request.auth.uid == resource.data.createdBy
          || request.auth.uid in resource.data.targetUserIds
        );
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
