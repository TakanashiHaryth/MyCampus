.buildlog/
.swiftpm/
migrate_working_dir/
cmake-build-*/
CMakeUserPresets.json

# Dart and Flutter generated files
**/.dart_tool/
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/doc/api/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.widget_preview/
